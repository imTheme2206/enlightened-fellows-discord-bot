# Copy to .env (hosted) or .env.local (local Supabase; Bun loads it over .env). Never commit real values.

# Discord bot credentials (not needed for `bun run dev:api`; any non-empty placeholder works there)
DISCORD_TOKEN=          # Bot token from Discord Developer Portal
DISCORD_CLIENT_ID=      # Application (client) ID
DISCORD_GUILD_ID=       # Guild (server) ID to register slash commands to

# Runtime
NODE_ENV=development    # development | production
LOG_LEVEL=info          # debug | info | warn | error
WEB_PORT=3003           # API port (default 3003)
CORS_ORIGIN=            # Frontend origin, e.g. http://localhost:3002

# Supabase / Postgres
# Hosted project: copy from the Supabase dashboard.
# Local (`supabase start`, see docs/local-development.md), mapping from `supabase status`:
#   SUPABASE_URL = "Project URL"      -> http://127.0.0.1:54321
#   DATABASE_URL = "Database URL"     -> postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   DIRECT_URL   = "Database URL"     -> same as DATABASE_URL (used by drizzle-kit)
SUPABASE_URL=
DATABASE_URL=
DIRECT_URL=

# Optional
WEB_ADMIN_TOKEN=        # Bearer token for the admin API routes
DISCORD_OWNER_ID=
CATALOG_REFRESH_CRON=   # Cron (UTC) for the MH Wilds catalog refresh; default "0 4 * * *" (daily 04:00)
