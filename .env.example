# Discord bot credentials
DISCORD_TOKEN=          # Bot token from Discord Developer Portal
DISCORD_CLIENT_ID=      # Application (client) ID
DISCORD_GUILD_ID=       # Guild (server) ID to register slash commands to

# Local Docker Postgres (use the credentials and database name from your container)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/elfellow
DIRECT_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/elfellow

# Hosted Supabase Auth project used by the frontend and API for sign-in
SUPABASE_URL=

# Runtime
NODE_ENV=development    # development | production
LOG_LEVEL=info          # debug | info | warn | error
WEB_PORT=3003           # API port (default 3003)
CORS_ORIGIN=            # Frontend origin, e.g. http://localhost:3002

# Optional
WEB_ADMIN_TOKEN=        # Bearer token for the admin API routes
DISCORD_OWNER_ID=
CATALOG_REFRESH_CRON=   # Cron (UTC); default "0 4 * * *" (daily 04:00)
