{
  "name": "enlightened-fellows-discord-bot",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup src/index.ts src/domains/set-search/search-worker.ts --format esm --minify",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check src",
    "gen:search-fixture": "tsx src/domains/set-search/__tests__/fixtures/generate-fixture.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@imthmn/mh-wilds-event-scraper": "^1.0.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "elysia": "2.0.0-beta.6",
    "elysia-rate-limit": "5.1.1",
    "exact-mirror": "1.2.4",
    "jose": "^6.2.10",
    "node-cron": "^4.6.0",
    "postgres": "^3.4.9",
    "ts-node": "^10.9.2",
    "typebox": "1.3.17",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/winston": "^2.4.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "type-fest": "5.6.0"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "packageManager": "bun@1.4.0"
}
