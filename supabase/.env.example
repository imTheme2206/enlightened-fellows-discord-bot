# Copy to supabase/.env (gitignored). Only needed to test real Discord OAuth locally.
# Create a Discord application at https://discord.com/developers/applications and add the redirect
# URI http://127.0.0.1:54321/auth/v1/callback. Without these, password sign-in still works.
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
